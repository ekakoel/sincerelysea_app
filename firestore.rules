rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('developer', false) == true
        );
    }

    function isDeveloper() {
      return isSignedIn()
        && request.auth.token.get('developer', false) == true;
    }

    function hasAdminScope(scope) {
      return isAdmin()
        && (
          isDeveloper()
          || !('adminScopes' in request.auth.token)
          || !(request.auth.token.adminScopes is list)
          || request.auth.token.adminScopes.size() == 0
          || request.auth.token.adminScopes.hasAny([scope, 'all'])
        );
    }

    function safeCustomerAuthorityFieldsOnCreate() {
      return (
          !('role' in request.resource.data)
          || request.resource.data.role == 'user'
        )
        && (
          !('adminScopes' in request.resource.data)
          || (
            request.resource.data.adminScopes is list
            && request.resource.data.adminScopes.size() == 0
          )
        )
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'isDeveloper',
          'permissions',
          'official',
          'isOfficial',
          'endorsement',
          'accountVerified',
          'verifiedOwner'
        ]);
    }

    function customerAuthorityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'adminScopes',
        'isAdmin',
        'isDeveloper',
        'permissions',
        'official',
        'isOfficial',
        'endorsement',
        'accountVerified',
        'verifiedOwner'
      ]);
    }

    function isOfficialStore(v) {
      return v == 'sincerelysea';
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isValidImageUrl(v) {
      return v == null
        || (v is string
          && (v.size() == 0
            || v.matches('^gs://.*$')
            || v.matches('^https://firebasestorage.googleapis.com/.*$')
            || v.matches('^https://storage.googleapis.com/.*$')));
    }

    function isValidUsername(v) {
      return v is string
        && v.matches('^[a-z0-9_]{3,20}$');
    }

    function isFollower(ownerUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/followers/$(request.auth.uid));
    }

    function canReadPost() {
      return isSignedIn();
    }

    function canReadPostById(postId) {
      return isSignedIn();
    }

    function validPostType() {
      return request.resource.data.type == null
        || request.resource.data.type in ['post', 'product'];
    }

    function validProductPostLink() {
      return request.resource.data.type != 'product'
        || (
          isAdmin()
          && request.resource.data.productId is string
          && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
          && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.userId == request.auth.uid
        );
    }

    function usernameUnchanged() {
      return onlyChanges([
          'displayName',
          'bio',
          'location',
          'website',
          'photoUrl',
          'email',
          'isPrivate',
          'allowComments',
          'updatedAt'
        ])
        && request.resource.data.get('username', '') == resource.data.get('username', '')
        && request.resource.data.get('usernameLower', '') == resource.data.get('usernameLower', '')
        && request.resource.data.get('usernameChangedOnce', false) == resource.data.get('usernameChangedOnce', false);
    }

    function usernameChangedOneTime() {
      return onlyChanges([
          'username',
          'usernameLower',
          'usernameChangedOnce',
          'updatedAt'
        ])
        && isValidUsername(request.resource.data.get('usernameLower', ''))
        && request.resource.data.get('username', '') == request.resource.data.get('usernameLower', '')
        && request.resource.data.get('usernameLower', '') != resource.data.get('usernameLower', '')
        && !(resource.data.get('usernameChangedOnce', false) == true)
        && request.resource.data.get('usernameChangedOnce', false) == true;
    }

    function shareCountIncrementedByOne() {
      return request.resource.data.shareCount is int
        && (
          (resource.data.shareCount is int
            && request.resource.data.shareCount == resource.data.shareCount + 1)
          || (!(resource.data.shareCount is int)
            && request.resource.data.shareCount == 1)
        );
    }

    function shareActorValid() {
      return request.resource.data.lastShareActorUid is string
        && request.resource.data.lastShareActorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if canReadPost();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidImageUrl(request.resource.data.imageUrl)
        && validPostType()
        && validProductPostLink()
        && (request.resource.data.visibility in ['public', 'followers', 'private'])
        && (
          request.resource.data.allowComments == null
          || request.resource.data.allowComments in ['everyone', 'followers', 'none']
        );

      // Owner can edit any post fields but cannot transfer ownership.
      allow update: if (isOwner(resource.data.uid)
          && request.resource.data.uid == resource.data.uid)
          && isValidImageUrl(request.resource.data.imageUrl)
          && validPostType()
          && validProductPostLink()
        // Non-owner updates are limited to engagement fields.
        || (isSignedIn()
          && request.resource.data.uid == resource.data.uid
          && (
            onlyChanges(['likes'])
            || (
              onlyChanges(['shareCount', 'lastShareActorUid'])
              && shareCountIncrementedByOne()
              && shareActorValid()
            )
          ));

      allow delete: if isOwner(resource.data.uid);

      match /comments/{commentId} {
        allow read: if canReadPostById(postId);

        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;

        // Owner can edit/delete own comment, others can only toggle likes.
        allow update: if (isOwner(resource.data.uid)
            && request.resource.data.uid == resource.data.uid)
          || (isSignedIn()
            && request.resource.data.uid == resource.data.uid
            && onlyChanges(['likes']));

        allow delete: if isOwner(resource.data.uid);

        match /replies/{replyId} {
          allow read: if canReadPostById(postId);

          allow create: if isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 500;

          allow update: if (isOwner(resource.data.uid)
              && request.resource.data.uid == resource.data.uid)
            || (isSignedIn()
              && request.resource.data.uid == resource.data.uid
              && onlyChanges(['likes']));

          allow delete: if isOwner(resource.data.uid);
        }
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasAdminScope('products')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerType == 'business'
        && isOfficialStore(request.resource.data.ownerId)
        && request.resource.data.storeName == 'SincerelySea Store'
        && request.resource.data.managedByAdmins == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number
        && request.resource.data.inventoryType in ['ready_stock', 'preorder']
        && request.resource.data.availableForPurchase is bool
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && (
          request.resource.data.preorderDays == null
          || request.resource.data.preorderDays is int
        )
        && (
          request.resource.data.preorderNote == null
          || request.resource.data.preorderNote is string
        )
        && request.resource.data.images is list;
      allow update, delete: if isSignedIn()
        && hasAdminScope('products')
        && resource.data.ownerType == 'business'
        && isOfficialStore(resource.data.ownerId)
        && resource.data.managedByAdmins == true;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || (hasAdminScope('orders') && isOfficialStore(resource.data.storeId))
        );
      allow create, update, delete: if false;
    }

    match /journal_entries/{entryId} {
      allow read: if hasAdminScope('finance');
      allow create, update, delete: if false;
    }

    match /sales_reports/{reportId} {
      allow read: if hasAdminScope('finance');
      allow create, update, delete: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if hasAdminScope('roles');
      allow create: if hasAdminScope('roles')
        && request.resource.data.action in ['role_updated', 'admin_access_updated']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.previousRole in ['user', 'admin', 'developer']
        && request.resource.data.newRole in ['user', 'admin', 'developer'];
      allow update, delete: if false;
    }

    match /usernames/{usernameLower} {
      // Username availability must be readable before registration.
      // No sensitive user data is stored in this collection.
      allow read: if isValidUsername(usernameLower);

      // Only authenticated users can reserve a username.
      allow create: if isSignedIn()
        && isValidUsername(usernameLower)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == usernameLower
        && !exists(
          /databases/$(database)/documents/usernames/$(usernameLower)
        );

      // Username documents cannot be modified after creation.
      allow update: if false;

      // Only the owner can release their username.
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && safeCustomerAuthorityFieldsOnCreate();
      allow delete: if isOwner(uid);
      allow update: if isOwner(uid)
        && customerAuthorityFieldsUnchanged()
        && (usernameUnchanged() || usernameChangedOneTime());

      // uid is the profile owner, followerUid is the authenticated follower id.
      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && followerUid == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
          && followerUid == request.auth.uid
          && uid != request.auth.uid;
      }

      match /follow_requests/{requestUid} {
        allow read: if isOwner(uid) || requestUid == request.auth.uid;
        allow create: if isSignedIn()
          && requestUid == request.auth.uid
          && uid != request.auth.uid;
        allow delete: if isOwner(uid) || requestUid == request.auth.uid;
        allow update: if isOwner(uid) || requestUid == request.auth.uid;
      }

      // uid is the authenticated user, targetUid is who they follow.
      match /following/{targetUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && targetUid != request.auth.uid
          && request.resource.data.uid == targetUid;
        allow delete: if isOwner(uid)
          && targetUid != request.auth.uid;
      }

      match /blocks/{targetUid} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /cart/{cartId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /hidden_posts/{postId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn()
          && request.resource.data.type is string
          && request.resource.data.actorUid == request.auth.uid;
      }

      match /support_tickets/{ticketId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 32
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 1000
          && request.resource.data.contactEmail is string
          && request.resource.data.contactEmail.size() > 0
          && request.resource.data.contactEmail.size() <= 120
          && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
          && request.resource.data.priority in ['low', 'normal', 'high']
          && (request.resource.data.attachmentName == null
            || request.resource.data.attachmentName is string)
          && isValidImageUrl(request.resource.data.attachmentUrl);

        allow update: if isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.category == resource.data.category
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.description == resource.data.description
          && request.resource.data.contactEmail == resource.data.contactEmail
          && request.resource.data.attachmentName == resource.data.attachmentName
          && request.resource.data.attachmentUrl == resource.data.attachmentUrl
          && request.resource.data.status == resource.data.status
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.createdAt == resource.data.createdAt;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.senderType == 'user'
            && request.resource.data.message is string
            && request.resource.data.message.size() > 0
            && request.resource.data.message.size() <= 1000;
          allow update, delete: if false;
        }
      }

      match /saved_posts/{postId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.postId == postId;
        allow delete: if isOwner(uid);
      }

      match /collections/{collectionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && isValidImageUrl(request.resource.data.imageUrl)
          && (
            request.resource.data.postId == null
            || request.resource.data.postId is string
          );
        allow delete: if isOwner(uid);
      }

      match /wishlists/{wishlistId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.status in ['active', 'fulfilled']
          && (
            !('type' in request.resource.data)
            || request.resource.data.type in ['manual', 'product']
          )
          && (
            !('productId' in request.resource.data)
            || request.resource.data.productId is string
          );

        allow update: if isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.status in ['active', 'fulfilled']
          && (
            !('type' in request.resource.data)
            || request.resource.data.type in ['manual', 'product']
          )
          && (
            !('productId' in request.resource.data)
            || request.resource.data.productId is string
          );

        allow delete: if isOwner(uid);
      }
    }

    match /reports/{reportId} {
      allow read: if hasAdminScope('community')
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.type in ['post', 'user']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120;
      allow update: if hasAdminScope('community')
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reason == resource.data.reason;
      allow delete: if false;
    }

    match /app_config/{configId} {
      // App reads feature flags/runtime config from app_config.
      allow read: if isSignedIn();
      // Only developer can change application-level configuration.
      allow create, update, delete: if isDeveloper();
    }
  }
}
